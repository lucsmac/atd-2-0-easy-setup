# Porta da API
PORT=3010

# Ambiente
NODE_ENV=development

# Banco de dados PostgreSQL (Docker local: postgres-crm)
DATABASE_URL='postgresql://atd:atd123@localhost:5435/atd_crm'

# Redis para BullMQ (Docker local: redis na porta 6379)
# O CRM compartilha o Redis principal com o Hosting
REDIS_HOST='localhost'
REDIS_PORT='6379'

# AWS Cognito (autenticacao)
COGNITO_USER_POOLS_ID=''
COGNITO_ACCESS_KEY_ID=''
COGNITO_SECRET_ACCESS_KEY=''
COGNITO_AWS_ACCESS_KEY_ID=''
COGNITO_AWS_SECRET_ACCESS_KEY=''

# AWS S3 (armazenamento de arquivos - opcional)
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_REGION='sa-east-1'
AWS_S3_BUCKET=''

# BullMQ - Configuracoes da fila de conversao
CONVERSION_QUEUE_CONCURRENCY='5'
CONVERSION_QUEUE_RETRY_LIMIT='3'
CONVERSION_QUEUE_BACKOFF_DELAY='2000'

# CORS - Origens permitidas (separadas por virgula)
CORS_ORIGINS='http://localhost:3000,http://localhost:3001'

# New Relic (opcional para desenvolvimento)
NEW_RELIC_APP_NAME=''
NEW_RELIC_LICENSE_KEY=''
